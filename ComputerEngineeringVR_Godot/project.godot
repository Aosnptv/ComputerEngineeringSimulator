[application]
config/name="Computer Engineering VR Simulator"
config/description="Bilingual VR-first computer engineering classroom simulator"
run/main_scene="res://scenes/startup/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"

[autoload]
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/persistence/save_manager.gd"
I18n="*res://scripts/localization/localization_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadButton,"button_index":0)]}
menu_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
hint_request={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":72)]}
recenter={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
turn_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
turn_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
grab_left={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":9)]}
grab_right={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":10)]}
activate_left={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":4)]}
activate_right={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":5)]}
teleport_activate={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":2)]}
capture_screenshot={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194343)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.055,0.09,1)

[xr]
openxr/enabled=true
shaders/enabled=true

